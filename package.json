{
  "name": "react-boilerplate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "check": "biome check --write --unsafe",
    "check:type": "npx tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "preview": "vite preview",
    "test": "vitest --silent",
    "test:cov": "vitest --coverage",
    "tsr:generate": "tsr generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-form": "^1.14.2",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-query-devtools": "^5.97.0",
    "@tanstack/react-router": "^1.129.8",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/valibot-form-adapter": "^0.42.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.19",
    "date-fns": "^4.1.0",
    "gsap": "^3.13.0",
    "i18next": "^26.0.4",
    "ky": "^2.0.0",
    "lucide-react": "^1.8.0",
    "qs": "^6.15.2",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "valibot": "^1.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@rolldown/plugin-babel": "^0.2.2",
    "@sentry/vite-plugin": "^5.2.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.129.8",
    "@tanstack/router-plugin": "^1.129.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.5.2",
    "@types/qs": "^6.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.8.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "h3-v2": "npm:h3@2.0.1-rc.20"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'tsc --noEmit'",
      "bash -c 'vite build'",
      "vitest related --run --silent=true"
    ],
    "*.{ts,tsx,js,jsx,json}": [
      "biome check"
    ]
  }
}