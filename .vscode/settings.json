{
	// ── Generated / Build Artifacts ──────────────────────────────────
	"files.watcherExclude": {
		"**/routeTree.gen.ts": true,
		"**/dist/**": true
	},
	"search.exclude": {
		"**/routeTree.gen.ts": true,
		"**/dist/**": true
	},
	"files.readonlyInclude": {
		"**/routeTree.gen.ts": true
	},
	// ── Editor ───────────────────────────────────────────────────────
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit",
		"source.action.useSortedKeys.biome": "explicit",
		"source.fixAll.biome": "explicit"
	},
	"editor.linkedEditing": true,
	"editor.guides.bracketPairs": "active",
	// ── Per-Language Formatter Overrides ─────────────────────────────
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	// ── TypeScript / JavaScript ──────────────────────────────────────
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"js/ts.suggest.autoImports": true,
	"js/ts.suggest.paths": true,
	"js/ts.preferences.importModuleSpecifier": "relative",
	"js/ts.validate.enabled": true,
	"js/ts.tsserver.experimental.enableProjectDiagnostics": true,
	"js/ts.tsserver.log": "off",
	"js/ts.tsserver.trace": "off",
	// ── Biome ────────────────────────────────────────────────────────
	"biome.enable": true,
	"biome.enableDiagnostics": true,
	"biome.enableFormatting": true,
	"biome.enableLinting": true,
	"biome.enableCodeActions": true,
	"biome.enableOrganizeImports": true,
	"biome.enableTypeChecking": true,
	"biome.enableAutoFixes": true,
	// ── Disabled Competing Tools ─────────────────────────────────────
	"eslint.enable": false,
	"prettier.enable": false,
	"tsimporter.enabled": false,
	// ── Debugging ────────────────────────────────────────────────────
	"debug.javascript.terminalOptions": {
		"resolveSourceMapLocations": [
			"${workspaceFolder}/**",
			"!**/node_modules/**",
			"**/node_modules/.vite-temp/**"
		]
	},
	// ── Tasks ────────────────────────────────────────────────────────
	"tasks.terminateOnExit": true
}